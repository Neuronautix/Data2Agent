{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Neuronautix/Data2Agent/schemas/assessment.schema.json",
  "title": "Data2Agent profile assessment",
  "description": "The output contract for any assessment profile (FAIR first). Declared in v0.1 and NOT produced by v0.1: the contract exists before the reasoning so that prose, rules, deterministic checks and SHACL can all be scored against one shape. Constraining the output shape is itself an experimental variable, so it must not be invented per profile.",
  "type": "object",
  "required": [
    "assessment_version",
    "dataset_id",
    "profile",
    "generator",
    "results"
  ],
  "additionalProperties": false,
  "properties": {
    "assessment_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "dataset_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "Binds the assessment to exact bytes. Two runs are only comparable at equal dataset_id."
    },
    "profile": {
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "examples": [
            "fair"
          ]
        },
        "version": {
          "type": "string"
        }
      }
    },
    "generator": {
      "type": "object",
      "required": [
        "mode"
      ],
      "description": "The experimental condition that produced this assessment.",
      "properties": {
        "mode": {
          "enum": [
            "raw",
            "structured",
            "fair-skill",
            "fair-rules",
            "fair-deterministic",
            "fair-semantic"
          ]
        },
        "host": {
          "type": "string",
          "examples": [
            "claude-code",
            "codex",
            "goose",
            "pi"
          ]
        },
        "orchestrator": {
          "type": "string",
          "examples": [
            "single-agent",
            "assessor-verifier",
            "specialist-team"
          ]
        },
        "model": {
          "type": "string"
        },
        "data2agent": {
          "type": "object",
          "description": "The Data2Agent build that computed this assessment: the serving process, which can differ from the build recorded in provenance.json at ingest. Required from assessment_version 0.2.0 (#33). Runs are comparable only at an equal build.",
          "required": [
            "version",
            "commit",
            "dirty"
          ],
          "properties": {
            "version": {
              "type": "string",
              "description": "The package version."
            },
            "commit": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-f]{40}$",
              "description": "The git commit the build ran from; null when it could not be established."
            },
            "dirty": {
              "type": [
                "boolean",
                "null"
              ],
              "description": "Whether the package source differed from that commit; null when unknown."
            },
            "commit_unavailable": {
              "type": "string",
              "description": "Why commit is null."
            }
          }
        }
      }
    },
    "results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/result"
      }
    },
    "unsupported_claims": {
      "type": "array",
      "description": "Statements the generator made that no evidence item supports. The primary error metric.",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "object",
      "description": "Derived count of results by outcome. Convenience only; the results array is authoritative.",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    }
  },
  "allOf": [
    {
      "description": "0.1.0 assessments predate generator.data2agent; every later version must carry it.",
      "if": {
        "properties": {
          "assessment_version": {
            "const": "0.1.0"
          }
        }
      },
      "else": {
        "properties": {
          "generator": {
            "required": [
              "mode",
              "data2agent"
            ]
          }
        }
      }
    },
    {
      "description": "The fair profile keeps its closed set of FAIR principles.",
      "if": {
        "properties": {
          "profile": {
            "properties": {
              "id": {
                "const": "fair"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        "required": [
          "profile"
        ]
      },
      "then": {
        "properties": {
          "results": {
            "items": {
              "properties": {
                "principle": {
                  "$ref": "#/$defs/fairPrinciple"
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "result": {
      "type": "object",
      "required": [
        "rule_id",
        "principle",
        "result",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "rule_id": {
          "type": "string",
          "examples": [
            "F1-PID-METADATA"
          ]
        },
        "principle": {
          "type": "string",
          "minLength": 1,
          "description": "For the fair profile: the FAIR principle the rule tests (enforced below). For any other profile: that profile's own category label."
        },
        "result": {
          "enum": [
            "pass",
            "fail",
            "unknown",
            "not_applicable"
          ],
          "description": "'unknown' is a first-class outcome. A profile may never resolve an unknown by inference."
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "description": "Evidence items, or claim ids from evidence.json. An 'unknown' result must still cite what was checked.",
          "items": {
            "type": [
              "object",
              "string"
            ]
          }
        },
        "rationale": {
          "type": "string"
        },
        "observations": {
          "type": "object",
          "description": "Structured observations recorded by a deterministic check; never a wider principle verdict."
        },
        "inferred": {
          "type": "boolean",
          "default": false,
          "description": "Must be false unless the rule explicitly sets inference_allowed: true."
        }
      }
    },
    "fairPrinciple": {
      "enum": [
        "F1",
        "F2",
        "F3",
        "F4",
        "A1",
        "A1.1",
        "A1.2",
        "A2",
        "I1",
        "I2",
        "I3",
        "R1",
        "R1.1",
        "R1.2",
        "R1.3"
      ]
    }
  }
}
