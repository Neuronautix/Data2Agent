{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Data2Agent offline CEDAR conversion report version 1",
  "type": "object",
  "required": ["schema_version", "status", "source", "snapshot_sha256", "policy", "policy_sha256", "fields", "artifact"],
  "properties": {
    "schema_version": {"const": "d2a-cedar-conversion-1"},
    "status": {"enum": ["exact", "blocked"]},
    "source": {
      "type": "object",
      "required": ["id", "version", "raw_sha256", "canonical_sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "raw_sha256": {"$ref": "#/$defs/digest"},
        "canonical_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "snapshot": {"type": "object"},
    "snapshot_sha256": {"$ref": "#/$defs/digest"},
    "policy": {"type": ["object", "null"]},
    "policy_sha256": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "fields": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["status", "codes"],
        "properties": {"status": {"enum": ["exact", "blocked"]}, "codes": {"type": "array", "items": {"type": "string"}}}
      }
    },
    "artifact": {"type": ["object", "null"]}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
